  "scripts": {
    "dev": "concurrently \"bun run --watch src/backend/index.ts\" \"vite\"",
    "build": "vite build && bun build src/backend/index.ts --compile --outfile dist/server",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
    "start": "bun run dist/server",
    "tauri-dev": "bunx tauri dev",
