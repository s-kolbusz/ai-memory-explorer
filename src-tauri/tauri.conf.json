{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Conversations Explorer",
  "version": "0.1.0",
  "identifier": "com.aimemory.explorer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "vite build && bun run build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "AI Conversations Explorer",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
